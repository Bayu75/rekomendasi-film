# Ganti dengan string acak yang panjang. Jangan biarkan kosong atau memakai nilai contoh.
SECRET_KEY=

# XAMPP bawaan: pengguna root tanpa kata sandi (seperti di bawah).
# Jika MySQL memakai kata sandi, tulis: mysql+pymysql://root:PASSWORD@localhost:3306/moviematch
DATABASE_URL=mysql+pymysql://root:@localhost:3306/moviematch

# Opsional. Nilai bawaan: models/recommender.joblib di akar proyek.
MOVIEMATCH_MODEL=models/recommender.joblib
